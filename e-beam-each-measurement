import numpy as np
import matplotlib.pyplot as plt

# Settings
U_acc = 5000         # accelerating voltage [V]
dU_acc = 100         # uncertainty accelerating voltage [V]
dU_plate = 100       # uncertainty plate voltage [V]
dy = 0.05            # readout uncertainty y [cm]
x = np.arange(3, 11) # positions where y is read [cm]

# Measurements: plate voltage [V] and deflection y [cm] at x = 3..10 cm
data = {
    "Measurement 2": (1900, [-0.01, 0.06, 0.15, 0.25, 0.42, 0.59, 0.78, 0.92]),
    "Measurement 3": (3000, [0.02, 0.12, 0.27, 0.46, 0.70, 0.89, 1.19, 1.45]),
    "Measurement 4": (4600, [0.07, 0.22, 0.45, 0.75, 1.11, 1.54, 2.02, 2.39]),
    "Measurement 5": (3100, [0.02, 0.13, 0.28, 0.48, 0.72, 0.99, 1.31, 1.55]),
}

colors = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100"]
markers = ["o", "s", "^", "D"]

fig, axes = plt.subplots(2, 2, figsize=(8, 6.4), dpi=200, sharex=True, sharey=True)

for ax, (name, (U_plate, y)), c, m in zip(axes.flat, data.items(), colors, markers):
    y = np.array(y)
    X = U_plate * x**2 / (4 * U_acc)        # X = U_plate x^2 / (4 U_acc)  [cm^2]
    dX = dU_plate * x**2 / (4 * U_acc)

    # Fit y = s X through the origin, s = 1/d
    s = np.sum(X * y) / np.sum(X**2)
    ds = dy / np.sqrt(np.sum(X**2))
    d = 1 / s

    # Error propagation
    rel = np.sqrt((ds / s)**2 + (dU_acc / U_acc)**2 + (dU_plate / U_plate)**2)
    dd = d * rel
    print(f"{name}: 1/d = {s:.4f} +/- {ds:.4f} 1/cm,  d = {d:.2f} +/- {dd:.2f} cm")

    ax.errorbar(X, y, xerr=dX, yerr=dy, fmt=m, ms=5.5, color=c, mec="white", mew=0.8,
                elinewidth=0.9, capsize=2, zorder=3, label="data")
    t = np.linspace(0, 25, 50)
    ax.plot(t, s * t, color="#1f1f1e", lw=1.5, zorder=2, label=r"fit $y = X/d$")

    ax.set_title(f"{name}, $U_{{plate}}$ = {U_plate} V:  $d$ = ({d:.1f} $\\pm$ {dd:.1f}) cm",
                 fontsize=10)
    ax.set_xlim(0, 24.5)
    ax.set_ylim(-0.15, 2.6)
    ax.grid(True, color="#e6e5e0", lw=0.7)
    ax.set_axisbelow(True)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.tick_params(direction="in", length=4)
    ax.legend(frameon=False, fontsize=9, loc="upper left")

for ax in axes[1, :]:
    ax.set_xlabel(r"$X = U_{plate}\,x^2/(4U_{acc})$  [cm$^2$]")
for ax in axes[:, 0]:
    ax.set_ylabel(r"deflection $y$  [cm]")

fig.tight_layout()
fig.savefig("A7_each_measurement.png")
plt.show()