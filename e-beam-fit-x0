import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit

# Settings
U_a = 5.0            # accelerating voltage [kV]
dU_p = 0.1           # uncertainty plate voltage [kV]
dy = 0.05            # readout uncertainty y [cm]
x = np.arange(3, 11) # positions where y is read [cm]

# Measurements: plate voltage [kV] and deflection y [cm] at x = 3..10 cm
data = {
    "Measurement 2": (1.9, [-0.01, 0.06, 0.15, 0.25, 0.42, 0.59, 0.78, 0.92]),
    "Measurement 3": (3.0, [0.02, 0.12, 0.27, 0.46, 0.70, 0.89, 1.19, 1.45]),
    "Measurement 4": (4.6, [0.07, 0.22, 0.45, 0.75, 1.11, 1.54, 2.02, 2.39]),
    "Measurement 5": (3.1, [0.02, 0.13, 0.28, 0.48, 0.72, 0.99, 1.31, 1.55]),
}

colors = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100"]
markers = ["o", "s", "^", "D"]

# Put all points in one list
U = np.concatenate([[U_p] * len(x) for U_p, y in data.values()])
xx = np.tile(x, len(data))
yy = np.concatenate([y for U_p, y in data.values()])

# Fit with free start point x0:  y = U_p (x - x0)^2 / (4 d U_a)
def model(Z, d, x0):
    U, xx = Z
    return U * (xx - x0)**2 / (4 * d * U_a)

p, c = curve_fit(model, (U, xx), yy, p0=[10, 0])
d, x0 = p
dd, dx0 = np.sqrt(np.diag(c))
print(f"d = {d:.2f} +/- {dd:.2f} cm,  x0 = {x0:.2f} +/- {dx0:.2f} cm")

fig, ax = plt.subplots(figsize=(6.4, 4.4), dpi=200)

for (name, (U_p, y)), col, m in zip(data.items(), colors, markers):
    y = np.array(y)
    X = U_p * (x - x0)**2 / (4 * U_a)        # X = U_p (x - x0)^2 / (4 U_a)  [cm^2]
    dX = dU_p * (x - x0)**2 / (4 * U_a)
    ax.errorbar(X, y, xerr=dX, yerr=dy, fmt=m, ms=5.5, color=col, mec="white",
                mew=0.8, elinewidth=0.9, capsize=2,
                label=f"{name}, $U_{{plate}}$ = {U_p} kV", zorder=3)

t = np.linspace(0, 20, 50)
ax.plot(t, t / d, color="#1f1f1e", lw=1.5, zorder=2,
        label=f"fit $y = X/d$,  $d$ = {d:.1f} cm,  $x_0$ = {x0:.1f} cm")

ax.set_xlabel(r"$X = U_{plate}\,(x-x_0)^2/(4U_{acc})$  [cm$^2$]")
ax.set_ylabel(r"deflection $y$  [cm]")
ax.set_xlim(0, 18.5)
ax.set_ylim(-0.15, 2.6)
ax.grid(True, color="#e6e5e0", lw=0.7)
ax.set_axisbelow(True)
ax.spines["top"].set_visible(False)
ax.spines["right"].set_visible(False)
ax.tick_params(direction="in", length=4)
ax.legend(frameon=False, fontsize=9.5, loc="upper left")

fig.tight_layout()
fig.savefig("A7_fit_x0.png")
plt.show()